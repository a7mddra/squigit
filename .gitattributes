# -----------------------------------------------------------------------------
# Core Configuration
# -----------------------------------------------------------------------------
* text=auto eol=lf

# -----------------------------------------------------------------------------
# Binary Files (Images, Fonts, Archives)
# -----------------------------------------------------------------------------
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.svg text

*.ttf binary
*.otf binary
*.woff binary
*.woff2 binary
*.eot binary

*.gz binary
*.zip binary
*.7z binary
*.tar binary
*.rar binary

# -----------------------------------------------------------------------------
# Code & Scripts
# -----------------------------------------------------------------------------
*.rs      text
*.cpp     text
*.h       text
*.hpp     text
*.mm      text
*.qml     text
*.cmake   text
*.sh      text eol=lf
*.toml    text
*.json    text
*.yaml    text
*.yml     text
*.md      text
